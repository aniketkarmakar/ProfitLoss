<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@android:color/holo_blue_light"/> <!-- background color -->

    <stroke
        android:width="2dp"
        android:color="@android:color/holo_red_light" /> <!-- border -->

    <corners android:radius="6dp"/> <!-- rounded corners -->

    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>
